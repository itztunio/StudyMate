# ChatBond AI Environment Configuration
# Replace the placeholder below with your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Flask Secret Key for Session Security (Change to any random string in production)
SECRET_KEY=chatbond-ai-production-secret-change-this

# Optional Server Port (Defaults to 5000)
PORT=5000
